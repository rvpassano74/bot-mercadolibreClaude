# Datos de tu app de Mercado Libre (los sacás de developers.mercadolibre.com)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://TU-SERVIDOR.onrender.com/oauth/callback

# Datos de tu bot de Telegram (los sacás de @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Datos de tu base de datos gratuita en Upstash (para que el bot no
# "se olvide" de la conexión cuando el servidor se reinicia)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clave secreta para usar /debug/* y /api/* (inventá una larga y no la compartas)
BOT_API_KEY=

# Planilla "Promociones MercadoLibre" (el ID está en la URL de la planilla)
PROMO_SHEET_ID=
# aviso = solo informa por Telegram lo que haría / auto = activa los descuentos
PROMO_MODO=aviso

# Puerto (dejalo así, Render lo configura solo)
PORT=3000
